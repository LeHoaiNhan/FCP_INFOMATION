NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chỉ dùng ở server (seed script, route handler) — TUYỆT ĐỐI không prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
